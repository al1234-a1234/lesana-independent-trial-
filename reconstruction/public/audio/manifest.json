    "bytes": 23554,
    "duration": 1.933061,
    "sha256": "68802eb4c7763e86b90bb686ae02034b11aa9c75b71a0ba86dd0a0ba69c17bd1",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "i-can-start-5",
    "text": "Then I write another one",
