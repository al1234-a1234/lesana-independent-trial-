    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "saturday-train-2",
    "text": "The train leaves after breakfast",
    "characters": 32,
    "bytes": 26688,
    "duration": 2.194286,
    "sha256": "1aed5adc9017ec711c506caac90a0ac80c13dc1e7786ac1dcb182812d121264b",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "saturday-train-3",
    "text": "A small dog sits beside me",
    "characters": 26,
    "bytes": 28883,
    "duration": 2.377143,
    "sha256": "715f6a31598ecac743609a0c2f96a89f1571b6b9eb2cd4a3469a66297117eff0",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "saturday-train-4",
    "text": "Its owner offers me an apple",
    "characters": 28,
    "bytes": 27629,
    "duration": 2.272653,
    "sha256": "bcf795324e87920817108bb77f86ab5c86a624fdf11dde0a0b7d200739a70397",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "saturday-train-5",
    "text": "We watch the sea through the window",
    "characters": 35,
    "bytes": 25121,
    "duration": 2.063673,
    "sha256": "c6135238247d602a1ba0dd897402b4c0995b202bd2ae5b973861a6c388896e8f",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "saturday-train-6",
    "text": "Now the journey feels much shorter",
    "characters": 34,
    "bytes": 28256,
    "duration": 2.324898,
    "sha256": "fb5aba1e1830e7dc9db48cc531065fff9829a50de887e571bf11ca647e16b6ed",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "rooftop-garden-1",
    "text": "Our roof was empty last spring",
    "characters": 30,
    "bytes": 28883,
    "duration": 2.377143,
    "sha256": "a0cd0c812591d4297a5e8f9b9b1cd6b1b304c789a42e4c8a5d8c54a317284961",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "rooftop-garden-2",
    "text": "Maya brought three pots of mint",
    "characters": 31,
    "bytes": 26062,
    "duration": 2.142041,
    "sha256": "13e3aa9dd5698ac3a74defdaea98b6f4c4cebe433b1ec2d1347e78909a4a39d4",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "rooftop-garden-3",
    "text": "We planted tomatoes beside the stairs",
    "characters": 37,
    "bytes": 36406,
    "duration": 3.004082,
    "sha256": "d84fabfddb49eacb448b2d0a8cadbe135d0c4826173e70ea146d5b2e3dfc502c",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "rooftop-garden-4",
    "text": "Every neighbor takes a turn watering",
    "characters": 36,
    "bytes": 32017,
    "duration": 2.638367,
    "sha256": "0d17e89f0edea8974ae7f9b12a05277afc6b50c9de93de9c7fa5782dc28875c9",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "rooftop-garden-5",
    "text": "Yesterday we shared our first harvest",
    "characters": 37,
    "bytes": 33585,
    "duration": 2.76898,
    "sha256": "cc1836894126174913b83392961a2929aa46b99462ad85c7ce3eae9b37520ba5",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "rooftop-garden-6",
    "text": "The roof is our favorite room now",
    "characters": 33,
    "bytes": 30137,
    "duration": 2.481633,
    "sha256": "9b12b613d07be1cefc54a5af177f6c92feb2eb715cc8c54a43a3edf4997a016d",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "little-exhibition-1",
    "text": "Lina almost canceled her first exhibition",
    "characters": 41,
    "bytes": 37660,
    "duration": 3.108571,
    "sha256": "59fd8e5c56f36c125b209379f6c66f91d103a3e4d3db54265bfc74d64be5df23",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "little-exhibition-2",
    "text": "She thought her paintings were too simple",
    "characters": 41,
    "bytes": 32958,
    "duration": 2.716735,
    "sha256": "f9f900fe70bc06398d3c9cc0b88998f19f4bef572169df38b81c5b14e641608b",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "little-exhibition-3",
    "text": "Her brother borrowed tables from the library",
    "characters": 44,
    "bytes": 33271,
    "duration": 2.742857,
    "sha256": "0f06b6a7729a83436e5bdb6d08e8c1fe5c221106f3a7c14b1b5f8c3697115709",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "little-exhibition-4",
    "text": "By sunset the little hall was full",
    "characters": 34,
    "bytes": 26688,
    "duration": 2.194286,
    "sha256": "284a3da30818a71e38ab2561371a47e8510c9ccde543bdacbb4a0050bddd2e1c",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "little-exhibition-5",
    "text": "A visitor recognized the street in one painting",
    "characters": 47,
    "bytes": 39227,
    "duration": 3.239184,
    "sha256": "e7cfba6b2cbdd9bb0ceef11a919a2b160ccbced05d1a51c56cee97c87ef0010c",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "little-exhibition-6",
    "text": "That conversation mattered more than any sale",
    "characters": 45,
    "bytes": 36719,
    "duration": 3.030204,
    "sha256": "cc2137ec53518a1da4fda456caf631a3e2be3269a68cc8997acbffcdd42ee2a9",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "i-can-start-1",
    "text": "I want to learn English",
    "characters": 23,
    "bytes": 19479,
    "duration": 1.593469,
    "sha256": "741ab6e5117794f94d76a806572ee92e3cb58412e2fd84bc3c02575f87ca4e43",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "i-can-start-2",
    "text": "I know some English words",
    "characters": 25,
    "bytes": 22613,
    "duration": 1.854694,
    "sha256": "74c00f876d49826dfdbcee51a408bd9575cd1e4aeb02785780de9521d72d380c",
    "generator": "FFmpeg libflite, built-in slt voice, 96 kbps MP3"
  },
  {
    "id": "i-can-start-3",
    "text": "Long sentences still scare me",
